# Copy this file to ".env" and fill in your own values. ".env" is ignored by Git.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/basuraoras

# Supabase (Project Settings > Database > Connection string > URI). Keep sslmode=require:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
